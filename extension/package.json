{
  "name": "gpt2-local-autocomplete",
  "displayName": "GPT-2 Local Autocomplete",
  "description": "Local AI code completion using GPT-2",
  "version": "0.0.1",
  "publisher": "prathmesh",
  "repository": {
    "type": "git",
    "url": "https://github.com/prathmeshmagar447/gpt2-local"
  },
  "icon": "icon.svg",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gpt2-autocomplete.toggle",
        "title": "GPT-2: Toggle",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.switchModel",
        "title": "GPT-2: Switch Model",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.benchmarkModels",
        "title": "GPT-2: Benchmark Models",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.manageModels",
        "title": "GPT-2: Manage Models",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.undoLast",
        "title": "GPT-2: Undo Last Completion",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.showHistory",
        "title": "GPT-2: Show Completion History",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.showStats",
        "title": "GPT-2: Show Statistics",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.openSettings",
        "title": "GPT-2: Open Settings",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.exportSettings",
        "title": "GPT-2: Export Settings",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.importSettings",
        "title": "GPT-2: Import Settings",
        "category": "AI Completion"
      },
      {
        "command": "gpt2-autocomplete.showCompletionStats",
        "title": "GPT-2: Show Completion Statistics",
        "category": "AI Completion"
      }
    ],
    "configuration": {
      "title": "Code Completion",
      "properties": {
        "codeCompletion.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "URL of the local completion server"
        },
        "codeCompletion.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Sampling temperature (lower = more deterministic)"
        },
        "codeCompletion.topP": {
          "type": "number",
          "default": 0.95,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Top-p sampling parameter"
        },
        "codeCompletion.topK": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 100,
          "description": "Top-k sampling parameter"
        },
        "codeCompletion.maxTokens": {
          "type": "number",
          "default": 64,
          "minimum": 10,
          "maximum": 512,
          "description": "Maximum tokens to generate for multiline completions"
        },
        "codeCompletion.modelName": {
          "type": "string",
          "default": "shibing624/code-autocomplete-gpt2-base",
          "description": "HuggingFace model name to use"
        },
        "codeCompletion.useQuantization": {
          "type": "boolean",
          "default": false,
          "description": "Enable 8-bit quantization (requires bitsandbytes)"
        },
        "codeCompletion.logLevel": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug"],
          "default": "info",
          "description": "Logging level for debugging"
        },
        "codeCompletion.suggestionTheme": {
          "type": "string",
          "enum": ["default", "subtle", "prominent", "colored"],
          "default": "default",
          "description": "Visual theme for code completion suggestions"
        },
        "codeCompletion.showCompletionStats": {
          "type": "boolean",
          "default": true,
          "description": "Show completion statistics in status bar"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "update-deps": "npm update && npm audit fix"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.28.0",
    "glob": "^8.1.0",
    "mocha": "^10.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
